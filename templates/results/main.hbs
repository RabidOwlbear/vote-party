<div class="main">
  <div class="title">{{{data.object.title}}}</div>
  <div class="description">{{{data.object.description}}}</div>
  <div class="results-cont">
   
  </div>
  <div class="controls">
    {{#if isComplete}}
      {{#if isCaller}}
        <button class="recall-btn">Re-call Vote</button>
      {{else}}
        <div class="spacer"></div>
      {{/if}}
    {{else}}
      <div class="spacer"></div>
    {{/if}}
    
    <button class="close">Close</button>
  </div>
</div>